# Copy to .env and edit. Every value here has a working default, so an empty .env is
# fine to start with. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env

# Signs the player session cookie. Without it, a new random key is generated on every
# boot, which logs everyone out on restart (games in progress end anyway, since rooms
# live in memory). Generate one with:  openssl rand -hex 32
SECRET_KEY=

# You are behind nginx/Traefik/Caddy, so trust one hop of X-Forwarded-* headers.
# Set to 0 only if the container is exposed directly, or clients could spoof them.
GN_BEHIND_PROXY=1

# Mark the session cookie Secure. Turn this on AFTER https works — while it's on,
# browsers refuse to store the cookie over plain http and nobody can join.
GN_COOKIE_SECURE=0

# Seconds a room lingers after the last person disconnects, before it's deleted.
GN_ROOM_IDLE_TIMEOUT=600

# Host port the container is published on, bound to 127.0.0.1. Point your proxy here.
HOST_PORT=5050

# --- GIF curator (docker compose --profile curator up -d curator) ---------------
# Who can reach the curator. It has NO login, so this is the only protection:
#   127.0.0.1        this machine only (default)
#   100.x.y.z        your Tailscale address — your devices only, incl. your phone
# Never 0.0.0.0 on a public server.
CURATOR_BIND=127.0.0.1
CURATOR_MIN_FRAMES=10
CURATOR_RATING=r

# For the curator only; not used by the game itself.
GIPHY_API_KEY=
