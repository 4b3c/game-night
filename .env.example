# Copy to .env and edit. Every value here has a working default, so an empty .env is
# fine to start with. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env

# Signs the player session cookie. Without it, a new random key is generated on every
# boot, which logs everyone out on restart (games in progress end anyway, since rooms
# live in memory). Generate one with:  openssl rand -hex 32
SECRET_KEY=

# You are behind nginx/Traefik/Caddy, so trust one hop of X-Forwarded-* headers.
# Set to 0 only if the container is exposed directly, or clients could spoof them.
GN_BEHIND_PROXY=1

# Mark the session cookie Secure. Turn this on AFTER https works — while it's on,
# browsers refuse to store the cookie over plain http and nobody can join.
GN_COOKIE_SECURE=0

# Seconds a room lingers after the last person disconnects, before it's deleted.
GN_ROOM_IDLE_TIMEOUT=600

# Host port the container is published on, bound to 127.0.0.1. Point your proxy here.
HOST_PORT=5050

# --- GIF curator (docker compose --profile curator up -d curator) ---------------
# The shared password for the curator. REQUIRED — it refuses to start without one,
# because a silent default would be worse than no gate at all. Anyone with this can
# retag the whole deck, which is the point: it's meant to be handed to friends.
# Four random words is plenty:  openssl rand -hex 8  works too.
CURATOR_PASSWORD=

# Signs the curator's session cookie. Optional — falls back to SECRET_KEY above.
CURATOR_SECRET_KEY=

# Mark that cookie Secure. Turn on AFTER https works, exactly like GN_COOKIE_SECURE.
CURATOR_COOKIE_SECURE=0

# Where nginx serves it from, on the game's own domain. The app uses this to build
# its own links, so it has to match the proxy's location block.
CURATOR_PREFIX=/curate

# Which address the container publishes on. Keep 127.0.0.1 when nginx is in front —
# the proxy reaches it and the internet only gets there through the password page.
CURATOR_BIND=127.0.0.1
CURATOR_RATING=r

# For the curator only; not used by the game itself. Also used by
# scripts/rehydrate_gifs.py to rebuild the GIF folder from curation/library.json.
GIPHY_API_KEY=
